{
  "name": "game-backlog",
  "version": "0.1.0",
  "description": "Obsidian plugin for managing a game backlog — add games with Steam rating, Steam Deck status and ProtonDB data.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "lefthook install"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@12.13.0",
  "devDependencies": {
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@types/node": "25.9.9",
    "builtin-modules": "5.4.0",
    "esbuild": "0.28.2",
    "lefthook": "2.2.2",
    "obsidian": "latest",
    "prettier": "3.9.9",
    "tslib": "2.8.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
